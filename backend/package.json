{
  "name": "celodesk-backend",
  "version": "0.1.0",
  "description": "Backend core for CeloDesk \u2014 AI-powered stablecoin invoicing on Celo (Agents at Work Hackathon, Real World Adoption track)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node scripts/with-env.js npx prisma generate",
    "prisma:migrate": "node scripts/with-env.js npx prisma migrate dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@celo/attribution-tags": "latest",
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "ox": "^1.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "prisma": "^5.19.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
