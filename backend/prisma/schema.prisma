// Canonical CeloDesk database schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PENDING
  PAID
  PARTIALLY_PAID
  OVERPAID
  FAILED
  CANCELLED
  EXPIRED
  OVERDUE
}

enum PaymentStatus {
  DETECTED
  VERIFYING
  VERIFIED
  REJECTED
}

enum ClientDecision {
  PENDING
  ACCEPTED
  DECLINED
}

enum Recurrence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// Batch payouts ("Collections"): a supervisor collects many payees via one
// shared link, reviews them, then pays everyone at once with a single Disperse
// transaction per token. Semantics are inverted vs Invoice: here the supervisor
// PAYS and each payee's wallet RECEIVES.
enum CollectionStatus {
  OPEN     // still accepting submissions
  CLOSED   // no longer accepting submissions
  PAID     // all accepted items have been paid out
}

enum CollectionItemStatus {
  PENDING   // submitted, awaiting the supervisor's accept/reject
  ACCEPTED  // approved, will be included in the batch payout
  REJECTED  // declined by the supervisor
  PAID      // paid out in a batch Disperse transaction
}

model User {
  id            String    @id @default(cuid())
  telegramId    String?   @unique
  email         String?   @unique
  // Nullable so an account can be created by Google sign-in before (or
  // without) a wallet. A wallet is still required to RECEIVE payments, so
  // invoice creation checks for one. Unique allows many NULLs in Postgres.
  walletAddress String?   @unique
  // Google sign-in identity (the "sub" claim). Nullable; set when a user
  // signs in with or links Google. One Google account maps to one user.
  googleId      String?   @unique
  // Display name from Google (used to prefill the business profile).
  name          String?
  // When the account's email was verified (Google verifies it for us).
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  invoices      Invoice[]
  collections   Collection[] @relation("CollectionSupervisor")
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])

  businessName    String
  slug            String   @unique
  tagline         String?
  logoUrl         String?
  description     String?
  websiteUrl      String?
  socialLinks     Json?    // { twitter, instagram, ... }

  preferredToken  String   @default("USDm") // symbol, see src/celo/tokens.ts
  acceptedTokens  String[] @default(["USDm", "USDC"])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id              String        @id @default(cuid())
  publicSlug      String        @unique @default(cuid())

  merchantId      String
  merchant        User          @relation(fields: [merchantId], references: [id])

  clientName      String
  clientContact   String?
  clientEmail     String?
  clientTelegram  String?
  // Captured when the client opens the invoice from a Telegram deep link, so
  // the bot can later push them an unpaid reminder (bots cannot cold-DM).
  clientTelegramChatId String?

  // Which delivery channels the merchant chose at creation time.
  deliverEmail    Boolean       @default(false)
  deliverTelegram Boolean       @default(false)

  // Unpaid-reminder throttle: cap total nudges and space them out across
  // email + Telegram (a single throttle so a client is never double-nagged).
  lastReminderAt  DateTime?
  reminderCount   Int           @default(0)

  // Client consent step: the payer accepts or declines before paying.
  // Tracked for every invoice; the checkout UI gates the Pay action on it.
  clientDecision    ClientDecision @default(PENDING)
  clientDecisionAt  DateTime?

  amount          Decimal       @db.Decimal(18, 6)
  tokenSymbol     String        // e.g. "USDm", "USDC" — see src/celo/tokens.ts
  tokenAddress    String        // resolved ERC20 contract address at creation time
  chainId         Int           @default(42220) // Celo mainnet

  receivingWallet String        // merchant's wallet at time of invoice creation

  description     String?
  dueDate         DateTime?

  status          InvoiceStatus @default(DRAFT)

  // Recurring invoices: the client accepts once, then a fresh invoice is
  // generated each cycle. No silent auto-charge; each cycle is paid by the
  // client like any other invoice.
  recurrence       Recurrence    @default(NONE)
  recurrenceEndsAt DateTime?
  nextRunAt        DateTime?
  parentInvoiceId  String?
  parentInvoice    Invoice?      @relation("InvoiceRecurrence", fields: [parentInvoiceId], references: [id])
  childInvoices    Invoice[]     @relation("InvoiceRecurrence")

  attributionTag  String        @default("celo_3fce81a170fc") // Agents on Open Rails tag; app always sets this explicitly in createInvoice

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime?

  payments        Payment[]

  @@index([merchantId, status])
}

model Payment {
  id                String        @id @default(cuid())
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])

  txHash            String        @unique
  chainId           Int
  fromAddress       String
  toAddress         String
  tokenAddress      String
  amount            Decimal       @db.Decimal(18, 6)

  status            PaymentStatus @default(DETECTED)
  confirmations     Int           @default(0)
  blockNumber       Int?

  rejectionReason   String?       // populated when status = REJECTED

  detectedAt        DateTime      @default(now())
  verifiedAt         DateTime?

  events            PaymentEvent[]

  @@index([invoiceId])
}

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])

  eventType   String   // e.g. "DETECTED", "CONFIRMATION", "VERIFIED", "REJECTED"
  detail      Json?
  createdAt   DateTime @default(now())
}



model Reminder {
  id          String   @id @default(cuid())
  invoiceId   String
  sentAt      DateTime @default(now())
  channel     String   // "telegram" | "email"
}

model Collection {
  id            String           @id @default(cuid())
  // Shared link key payees open to submit their payout request.
  publicSlug    String           @unique @default(cuid())

  supervisorId  String
  supervisor    User             @relation("CollectionSupervisor", fields: [supervisorId], references: [id])

  title         String
  description   String?
  // If non-empty, payees may only submit in these token symbols; empty = any
  // verified token is allowed.
  allowedTokens String[]         @default([])

  status        CollectionStatus @default(OPEN)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items         CollectionItem[]

  @@index([supervisorId, status])
}

model CollectionItem {
  id            String               @id @default(cuid())
  collectionId  String
  collection    Collection           @relation(fields: [collectionId], references: [id])

  payeeName     String
  payeeWallet   String               // the wallet this payee is paid to
  // Optional: lets the organizer email this payee if their submission is
  // rejected (e.g. wrong wallet) so they can fix it and resubmit.
  payeeEmail    String?
  tokenSymbol   String               // e.g. "USDC" — see src/celo/tokens.ts
  tokenAddress  String               // resolved ERC20 address at submit time
  amount        Decimal              @db.Decimal(18, 6)
  note          String?

  status        CollectionItemStatus @default(PENDING)
  // The organizer's reason when rejecting, shown/sent to the payee.
  rejectionNote String?

  // Set when paid out via the batch Disperse transaction.
  txHash        String?
  paidAt        DateTime?

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([collectionId, status])
}
