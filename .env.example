# CeloDesk shared environment
# Keep this file local. Never commit it or expose server-only values to the browser.

# Database / Celo
DATABASE_URL=
RPC_URL=https://forno.celo.org

# Authentication
JWT_SECRET=

# AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Telegram / agent
TELEGRAM_BOT_TOKEN=
BACKEND_API_URL=http://localhost:3001

# Server
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Public frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=42220

# Only if/when ERC-8004 registration is run locally.
PRIVATE_KEY=

# Track 2: x402 USA₮ settlement lane.
# X402_API_KEY: seller key created at x402.celo.org (connect wallet, sign, copy).
# Server-side only; required for /settle. Anyone with it can spend your balance.
X402_API_KEY=
# Optional override; defaults to the hosted facilitator.
X402_FACILITATOR_URL=https://api.x402.celo.org
# Only for the buyer-side demo script (scripts/x402-pay.ts): an INDEPENDENT
# payer wallet that holds USA₮. Never the merchant/agent wallet.
X402_PAYER_KEY=
