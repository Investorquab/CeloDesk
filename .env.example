# CeloDesk shared environment
# Keep this file local. Never commit it or expose server-only values to the browser.

# Database / Celo
DATABASE_URL=
RPC_URL=https://forno.celo.org

# Authentication
JWT_SECRET=

# AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Telegram / agent
TELEGRAM_BOT_TOKEN=
BACKEND_API_URL=http://localhost:3001

# Email delivery + reminders (Brevo). Free tier, single verified sender.
# The API key starts xkeysib- (NOT the xsmtpsib- SMTP key). At deploy, also
# authorize the server's public IP in Brevo (Security > Authorized IPs).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CeloDesk

# Shared secret for backend<->bot internal calls (Telegram unpaid reminders).
# Set the SAME value for the backend and the agent. If unset, Telegram
# reminders are disabled (email reminders still run).
INTERNAL_API_KEY=

# Scheduler tuning (optional; sensible defaults in code).
# RECURRENCE_DISABLED=1 to turn off recurring-invoice spawning.
# RECURRENCE_INTERVAL_MS, REMINDER_POLL_MS, REMINDER_MAX,
# REMINDER_COOLDOWN_MS, REMINDER_GRACE_MS override the defaults.

# Server
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Public frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=42220

# Only if/when ERC-8004 registration is run locally.
PRIVATE_KEY=

# Track 2: x402 USA₮ settlement lane.
# X402_API_KEY: seller key created at x402.celo.org (connect wallet, sign, copy).
# Server-side only; required for /settle. Anyone with it can spend your balance.
X402_API_KEY=
# Optional override; defaults to the hosted facilitator.
X402_FACILITATOR_URL=https://api.x402.celo.org
# Only for the buyer-side demo script (scripts/x402-pay.ts): an INDEPENDENT
# payer wallet that holds USA₮. Never the merchant/agent wallet.
X402_PAYER_KEY=
